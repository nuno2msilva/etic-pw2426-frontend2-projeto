# ============================================================
# Sushi Dash — Server Environment Variables
# ============================================================
# Copy to .env and fill in your PostgreSQL credentials.
# ============================================================

# PostgreSQL connection (Prisma)
# Local:    postgresql://postgres:password@localhost:5432/sushi_dash
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/sushi_dash?sslmode=require
# Supabase: postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/sushi_dash

# JWT secret — change this to a random string in production!
JWT_SECRET=sushi-dash-dev-secret-change-me

# Server
PORT=3001
