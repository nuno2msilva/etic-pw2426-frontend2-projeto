# Umami Analytics Configuration
# Required for production analytics tracking
# Set these values in Vercel project settings under "Environment Variables"

# Your Umami tracking ID from https://app.umami.is
NEXT_PUBLIC_UMAMI_ID=your_tracking_id_here

# Umami analytics endpoint (defaults to cloud if not set)
# For cloud: https://analytics.umami.is
# For self-hosted: http://your-umami-domain.com
NEXT_PUBLIC_UMAMI_ENDPOINT=https://cloud.umami.is

# Optional: Comma-separated list of domains to exclude from tracking
NEXT_PUBLIC_UMAMI_EXCLUDE_DOMAINS=localhost,127.0.0.1

# Database connection (if using server-side analytics)
# DATABASE_URL=postgresql://user:password@host:port/database

# API Configuration
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-side variables (not exposed to client)
# NODE_ENV=production
