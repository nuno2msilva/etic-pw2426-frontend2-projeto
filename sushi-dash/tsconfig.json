{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/features/*": ["./src/features/*"],
      "@/features/customer": ["./src/features/customer"],
      "@/features/customer/*": ["./src/features/customer/*"],
      "@/features/staff": ["./src/features/staff"],
      "@/features/staff/*": ["./src/features/staff/*"],
      "@/features/admin": ["./src/features/admin"],
      "@/features/admin/*": ["./src/features/admin/*"],
      "@/features/kitchen": ["./src/features/kitchen"],
      "@/features/kitchen/*": ["./src/features/kitchen/*"],
      "@/features/shared": ["./src/features/shared"],
      "@/features/shared/*": ["./src/features/shared/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "pages/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "server"
  ]
}
